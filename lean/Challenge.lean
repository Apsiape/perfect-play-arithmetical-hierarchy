namespace Sigma2

inductive LabelType where
  | unitary | projection | positive | contraction
  deriving DecidableEq, Repr, Encodable

inductive Expr where
  | scalar (q : ℚ)
  | label (i : ℕ)
  | add (p q : Expr)
  | mul (p q : Expr)
  | adj (p : Expr)
  deriving DecidableEq, Repr, Encodable

def Expr.eval (I : Op) (L : ℕ → Op) : Expr → Op
  | .scalar q => (q : ℂ) • I
  | .label i => L i
  | .add p q => p.eval I L + q.eval I L
  | .mul p q => p.eval I L * q.eval I L
  | .adj p => star (p.eval I L)

def Expr.labels : Expr → List ℕ
  | .scalar _ => []
  | .label i => [i]
  | .add p q | .mul p q => p.labels ++ q.labels
  | .adj p => p.labels

/-- Central polynomials and endpoint sums are separate syntax classes. No
centralizer word contains a modular transport or two creation operators. -/
structure Presentation where
  types : List LabelType
  root : ℕ
  transported : List ℕ
  central : List Expr
  endpoints : List (Expr × Fin 4 × Fin 4 × Expr)
  zeros : List (Expr × Fin 4)
  linear : List (List (Expr × Fin 4 × Expr))
  deriving DecidableEq, Repr, Encodable

def Presentation.admissible (P : Presentation) : Prop :=
  P.types[P.root]? = some .projection ∧
  (∀ i ∈ P.transported, i < P.types.length) ∧
  (∀ p ∈ P.central, ∀ i ∈ p.labels, i < P.types.length) ∧
  (∀ r ∈ P.endpoints, (∀ i ∈ r.1.labels, i ∈ P.transported) ∧
    (∀ i ∈ r.2.2.2.labels, i < P.types.length)) ∧
  (∀ r ∈ P.zeros, ∀ i ∈ r.1.labels, i ∈ P.transported) ∧
  (∀ row ∈ P.linear, ∀ r ∈ row,
    (∀ i ∈ r.1.labels, i < P.types.length) ∧
    (∀ i ∈ r.2.2.labels, i < P.types.length))

run_cmd Lean.modifyEnv (fun env => env.setMainModule `Sigma2.PaperAdmissibility)

/-- Printed Definition 4.4: "Every label used on a left endpoint is included
in the transported unitary list" and "the root projection is transported even
when it occurs in no endpoint equation".  The left expression in every finite
sum term is a left endpoint too.  These are exactly the two conjuncts missing
from the frozen `Presentation.admissible`; this wrapper changes no old syntax. -/
def PaperAdmissible (P : Presentation) : Prop :=
  P.admissible ∧ P.root ∈ P.transported ∧
    ∀ row ∈ P.linear, ∀ r ∈ row, ∀ i ∈ r.1.labels, i ∈ P.transported

/-- One total computable game family witnesses promised hardness for both languages. -/
def SharedFamilyHardness : Prop :=
  ∀ S, SigmaTwo S → ∃ f : ℕ → ℕ, Computable f ∧
    (∀ e, PromisedGame (f e)) ∧
    (∀ e, S e ↔ SpatialPerfect (f e)) ∧
    (∀ e, S e ↔ EntropyPerfect (f e))

end Sigma2


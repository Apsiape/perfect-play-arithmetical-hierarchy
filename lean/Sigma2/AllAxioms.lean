import Lean.Util.CollectAxioms
set_option maxHeartbeats 20000000
open Lean Elab Command
run_cmd do
  let env ← getEnv
  let standard := [``propext, ``Classical.choice, ``Quot.sound]
  let mut count : Nat := 0
  for (n, ci) in env.constants.toList do
    let inProject := match env.getModuleIdxFor? n with
      | some idx => env.allImportedModuleNames[idx]!.toString.startsWith "Sigma2."
      | none => n.toString.startsWith "Sigma2."
    if inProject then
      if ci matches .axiomInfo _ then throwError "Project axiom: {n}"
      let ax := (← Lean.collectAxioms n).toList
      for a in ax do
        unless standard.contains a do throwError "Unexpected axiom {a} in {n}"
      elabCommand (← `(#print axioms $(mkIdent n)))
      count := count + 1
      logInfo m!"PROJECT_AXIOMS:{toJson (n.toString, ax.map Name.toString) |>.compress}"
  logInfo m!"PROJECT_DECLARATIONS:{count}"
